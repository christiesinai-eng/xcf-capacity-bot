# Copy this file to ~/.xcf-lighthouse.env  (your home folder, NOT the shared Drive folder).
# The shared folder is readable by the whole team, so tokens must never be saved in it.
# Only the three secrets below are personal; the rest are ids that are safe to share.

# --- SECRETS: fill these in yourself --------------------------------------------------
# Your own Asana personal access token: asana.com > profile > Settings > Apps > Developer console.
# Use your own - a shared token puts someone else's name on every API call.
ASANA_TOKEN=
# Slack bot token (xoxb-...), needs groups:history and users:read. This is one shared bot, so
# ask Christie for it through a private channel. Never post it in Drive, Slack channels or git.
SLACK_TOKEN=
# Optional - only used by the legacy Slack poster.
SLACK_WEBHOOK_URL=

# --- Ids (not secret) ----------------------------------------------------------------
ASANA_WORKSPACE_GID=41261904390129
ASANA_TEAM_GID=1211868948534506
# Estimated time custom field. NOTE: stored in MINUTES, not hours.
ASANA_FIELD_GID_ESTIMATED_TIME=1203387567618671
SLACK_CHANNEL_ID=C0B4FT24SG3

# --- Costings report (separate, optional) ---------------------------------------------
ASANA_FIELD_GID_COST=1213828392202051
ASANA_FIELD_GID_AI_CREDITS=1213617495561849
ASANA_FIELD_GID_AI_TOOLS=1215403593648539
ASANA_FIELD_GID_CREDIT_TYPE=1215403583807476
ASANA_PROJECT_GID_COST_PER_ASSET=1212300038541375
ASANA_PORTFOLIO_GID_XCF_PROJECTS=1217215893985481

# POD membership is NOT set here any more - it lives in config/pod-map.json in the shared folder.
